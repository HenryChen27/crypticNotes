+  function settleSupportedPiles(step) {
+    const items=G.items.filter(i=>i.bodyInWorld&&!i.isMerging);
+    const byBody=new Map(items.map(i=>[i.body,i]));
+    const neighbours=new Map(items.map(i=>[i.body,[]]));
+    const anchors=new Set();
+    for(const pair of G.engine.pairs.list) {
+      if(!pair.isActive)continue;
+      const a=pair.bodyA.parent,b=pair.bodyB.parent;
+      if(byBody.has(a)&&byBody.has(b)){neighbours.get(a).push(b);neighbours.get(b).push(a);}
+      if(byBody.has(a)&&b.label==='floor')anchors.add(a);
+      if(byBody.has(b)&&a.label==='floor')anchors.add(b);
+    }
+    for(const item of items) {
+      const body=item.body,radius=Math.max(item.w,item.h)/2;
+      if(Math.hypot(body.position.x-item.previousPose.x,body.position.y-item.previousPose.y)>1.5) {
+        item.stillPose=null;item.settleSample=null;
+      }
+      const sample=item.settleSample||(item.settleSample={time:0,count:0,x:0,y:0,angle:0});
+      sample.time+=step;sample.count++;sample.x+=body.position.x;sample.y+=body.position.y;sample.angle+=body.angle;
+      if(sample.time>=250) {
+        const x=sample.x/sample.count,y=sample.y/sample.count,angle=sample.angle/sample.count;
+        const still=item.stillPose;
+        if(!still||Math.hypot(x-still.x,y-still.y)>1.5
+          ||(!body.circleRadius&&Math.abs(angle-still.angle)*radius>1.5)) {
+          item.stillPose={x,y,angle,elapsed:0};
+        }else still.elapsed+=sample.time;
+        sample.time=0;sample.count=0;sample.x=0;sample.y=0;sample.angle=0;
+      }
+      if(body.isSleeping)anchors.add(body);
+    }
+    const visited=new Set();
+    for(const item of items) {
+      if(visited.has(item.body))continue;
+      const island=[],queue=[item.body];let grounded=false,quiet=true;
+      while(queue.length) {
+        const body=queue.pop();if(visited.has(body))continue;
+        visited.add(body);island.push(body);
+        grounded=grounded||anchors.has(body);
+        quiet=quiet&&(body.isSleeping||(byBody.get(body).stillPose?.elapsed||0)>=1500);
+        for(const next of neighbours.get(body))if(!visited.has(next))queue.push(next);
+      }
+      // Sleep only supported contact islands whose actual poses stay stable.
+      // Incoming impacts and merges still wake them through the normal engine.
+      if(grounded&&quiet)for(const body of island) {
+        if(!body.isSleeping)Sleeping.set(body,true);
+        byBody.get(body).previousPose={x:body.position.x,y:body.position.y,angle:body.angle};
+      }
+    }
+  }
